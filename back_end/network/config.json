{
    "network": {
        "node_id": "",
        "node_type": "validator",
        "listen_host": "0.0.0.0",
        "listen_port": 5000,
        "max_peers": 2,
        "ping_interval": 30,
        "peer_timeout": 120
    },
    "seed_nodes": [
        {
            "name": "Node A (Local)",
            "ip": "127.0.0.1",
            "port": 5000,
            "public_key": "",
            "role": "validator"
        },
        {
            "name": "Node B (Local)",
            "ip": "127.0.0.1",
            "port": 5001,
            "public_key": "",
            "role": "validator"
        }
    ],
    "whitelist": {
        "enabled": false,
        "authorized_validators": []
    },
    "gossip": {
        "fan_out_factor": 0.5,
        "min_fan_out": 3,
        "max_fan_out": 10,
        "transaction_ttl": 300,
        "block_ttl": 600
    },
    "ntp": {
        "servers": [
            "pool.ntp.org",
            "time.google.com",
            "time.cloudflare.com"
        ],
        "sync_interval": 3600,
        "max_offset": 2.0
    },
    "consensus": {
        "slot_duration": 5,
        "block_time": 5,
        "validator_rotation": true,
        "max_transactions_per_block": 100
    },
    "keystore": {
        "filepath": "node.keystore",
        "algorithm": "AES-256-GCM",
        "kdf": "PBKDF2-HMAC-SHA256",
        "kdf_iterations": 100000
    }
}